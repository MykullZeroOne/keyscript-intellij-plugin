<idea-plugin>
    <id>com.revfcu.keyscript-ide</id>
    <name>Keyscript IDE</name>
    <vendor email="support@revfcu.com" url="http://www.revfcu.com">REV Federal Credit Union</vendor>

    <description><![CDATA[
    Enhanced Keyscript IDE for JetBrains.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.revfcu.keyscript.auth.AuthenticationManager"/>
        <projectService serviceImplementation="com.revfcu.keyscript.options.ScriptOptionsService"/>
        <toolWindow id="Keyscript Options" secondary="true" anchor="right" factoryClass="com.revfcu.keyscript.options.ScriptOptionsToolWindowFactory"/>
        <notificationGroup id="Keyscript Notifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="KeyscriptMenu" text="Keyscript" popup="true">
            <add-to-group group-id="MainMenu" anchor="last"/>
            <action id="com.revfcu.keyscript.actions.LoginAction"
                    class="com.revfcu.keyscript.actions.LoginAction"
                    text="Logon to Keystone"
                    description="Logs into the Keystone server via Keybridge API">
            </action>
        </group>
    </actions>
</idea-plugin>
